# Copy to .env and adjust. `make` loads .env automatically.
# Never commit .env.

# development | production
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://makonbook:makonbook@localhost:5432/makonbook?sslmode=disable

# debug | info | warn | error
LOG_LEVEL=info
# text | json (defaults to json in production)
LOG_FORMAT=text
SHUTDOWN_TIMEOUT=15s
# true only behind a reverse proxy (the edge nginx) that sets X-Forwarded-For.
TRUST_PROXY=false

# School time zone: decides what "today" means for schedules.
TIMEZONE=Asia/Tashkent

# HolliHop sync (needed by `makonbook worker` and `makonbook sync`).
HOLLIHOP_BASE_URL=https://satmakon.t8s.ru/Api/V2
HOLLIHOP_AUTHKEY=
# Attendance write-back (spec 8.6). Leave false until the supervised test
# lesson: until then the worker only records what it would send.
HOLLIHOP_WRITE_ENABLED=false
# Only if that test shows absences end up unbilled: send them as billed.
HOLLIHOP_ABSENT_PAYABLE=false
SYNC_INTERVAL=15m
SYNC_FULL_AT=03:00

# Optional: send sync alerts to a Telegram chat. Set both or neither.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# Used by `make test` for integration tests. Each test creates and drops its
# own database, so this role needs CREATEDB.
TEST_DATABASE_URL=postgres://makonbook:makonbook@localhost:5432/makonbook_test?sslmode=disable
