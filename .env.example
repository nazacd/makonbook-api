# Copy to .env and adjust. `make` loads .env automatically.
# Never commit .env.

# development | production
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://makonbook:makonbook@localhost:5432/makonbook?sslmode=disable

# debug | info | warn | error
LOG_LEVEL=info
# text | json (defaults to json in production)
LOG_FORMAT=text
SHUTDOWN_TIMEOUT=15s
# true only behind a reverse proxy (the edge nginx) that sets X-Forwarded-For.
TRUST_PROXY=false

# School time zone: decides what "today" means for schedules.
TIMEZONE=Asia/Tashkent

# HolliHop sync (needed by `makonbook worker` and `makonbook sync`).
HOLLIHOP_BASE_URL=https://satmakon.t8s.ru/Api/V2
HOLLIHOP_AUTHKEY=
# Attendance write-back (spec 8.6). Leave false until the supervised test
# lesson: until then the worker only records what it would send.
HOLLIHOP_WRITE_ENABLED=false
# Only if that test shows absences end up unbilled: send them as billed.
HOLLIHOP_ABSENT_PAYABLE=false
SYNC_INTERVAL=15m
SYNC_FULL_AT=03:00

# Optional: send sync alerts to a Telegram chat. Set both or neither.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# Used by `make test` for integration tests. Each test creates and drops its
# own database, so this role needs CREATEDB.
TEST_DATABASE_URL=postgres://makonbook:makonbook@localhost:5432/makonbook_test?sslmode=disable

# Accounts (spec 21). Sign-up and password reset by a code sent by SMS:
# empty = off, "log" = development only (the code goes to the log),
# "eskiz" = Eskiz.uz with the account below. Eskiz sends only approved texts:
# SMS_TEXT must match a template approved in the Eskiz account.
SMS_PROVIDER=log
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
SMS_TEXT=SATMAKON: your code is {code}
# Google sign-in: set both (empty = off) and WEB_ORIGIN, the web app's origin
# that serves /v1/ from this API; Google's redirect URI is
# ${WEB_ORIGIN}/v1/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WEB_ORIGIN=http://localhost:5173

# Email codes, sign-up's first step (or Google): empty = off, "log" =
# development only (the code goes to the log), else the SMTP server
# (587 STARTTLS or 465 TLS).
SMTP_HOST=log
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=SATMAKON <no-reply@makonbook.uz>
