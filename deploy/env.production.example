# Copy to /opt/makonbook-api/.env on the VPS and fill in. chmod 600.
# APP_ENV, HTTP_ADDR and TRUST_PROXY are set in docker-compose.yml.

# Image to run. Pin a version (sha-xxxxxxx) to deploy exactly that build;
# "latest" follows the main branch.
API_IMAGE=nazacd/makonbook-api:latest

# Own database and role in the shared `db` container (see DEPLOY.md step 2).
DATABASE_URL=postgres://makonbook_api:CHANGE_ME@db:5432/makonbook_api?sslmode=disable

LOG_LEVEL=info
TIMEZONE=Asia/Tashkent

HOLLIHOP_BASE_URL=https://satmakon.t8s.ru/Api/V2
HOLLIHOP_AUTHKEY=CHANGE_ME
# Attendance write-back (spec 8.6). Leave false until the supervised test
# lesson: until then the worker only records what it would send.
HOLLIHOP_WRITE_ENABLED=false
# Only if that test shows absences end up unbilled: send them as billed.
HOLLIHOP_ABSENT_PAYABLE=false
SYNC_INTERVAL=15m
SYNC_FULL_AT=03:00

# The admin panel's host name (deploy/nginx-admin.conf). Empty: no panel.
ADMIN_HOST=admin.makonbook.uz

# Optional sync alerts to a Telegram chat (both or neither).
# R2 (read only): SAT MAKON's bucket with the question figures and screenshots,
# shown to practice editors. Optional; without it the editor shows no images.
# Use a read-only R2 API token.
R2_ENDPOINT_URL=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

# R2 uploads: MakonBook's own bucket, where editors' images go. Optional;
# without it editors can't upload images. A token with Object Read & Write on
# this bucket only. The endpoint defaults to R2_ENDPOINT_URL.
R2_UPLOADS_BUCKET=
R2_UPLOADS_ACCESS_KEY_ID=
R2_UPLOADS_SECRET_ACCESS_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# The teachers' group review bot (makonbook review-bot, the `bot` service): its
# own bot from @BotFather, an admin of the teachers' group. Leave the chat ID
# empty at first: the bot then logs the group's ID when it's added (or on
# /start@<bot> in the group); put it here and `docker compose up -d`.
TELEGRAM_REVIEW_TOKEN=
TELEGRAM_REVIEW_CHAT_ID=
